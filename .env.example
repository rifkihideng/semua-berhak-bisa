# Salin file ini menjadi .env (di root project) lalu isi sesuai kebutuhan.
# Variabel frontend harus diawali dengan VITE_ agar terbaca oleh Vite.

# URL backend untuk produksi, contoh: https://api-domain-anda.com
# Kosongkan saat development (local) karena request /api sudah diproxy Vite ke http://localhost:3001
VITE_API_URL=
