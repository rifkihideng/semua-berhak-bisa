# Salin file ini menjadi .env lalu isi sesuai nilai Anda.
# Untuk mode SQLite lokal, biarkan kedua variabel ini kosong.

# URL database Turso, contoh: libsql://nama-db-anda.turso.io
TURSO_DATABASE_URL=

# Token autentikasi Turso
TURSO_AUTH_TOKEN=

# Port server API (default 3001)
PORT=3001

# Password admin (hash + salt scrypt) untuk akses halaman admin.
# Generate dengan: node -e "import('node:crypto').then(c=>{const s=c.randomBytes(16).toString('hex');console.log('SALT='+s);console.log('HASH='+c.scryptSync('PASSWORD_ANDA',Buffer.from(s,'hex'),64).toString('hex'))})"
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=

# Origin frontend yang diizinkan (pisahkan dengan koma untuk beberapa origin)
CORS_ORIGIN=http://localhost:5173
